{
    "elements": [
        {
            "type": "Label",
            "caption": "Tile configuration:",
            "bold": true
        },
        {
            "type": "Label",
            "caption": "The Resident Status Tile graphically represents the presence status of up to 5 residents."
        },
        {
            "type": "Label",
            "caption": "Residents are configured in the list below; as many as you like. (Optional) Photos must be created as media objects. Photos should have an aspect ratio of 1:1. If a resident is absent, the photo will be displayed in grayscale. Present residents in color."
        },
        {
            "type": "Label",
            "caption": "A Bool variable is needed for each resident. (true = present, false = absent)"
        },
        {
            "type": "Label",
            "caption": "Example of a configured tile"
        },
        {
            "type": "Image",
            "image": "data:image/jpeg;base64,"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile design",
            "items": [
                {
                    "type": "Label",
                    "caption": "Tile",
                    "bold": true
                },
                {
                    "type": "CheckBox",
                    "name": "BG_Off",
                    "caption": "Standard background image"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectMedia",
                            "name": "bgImage",
                            "caption": "Background image"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "Bildtransparenz",
                            "caption": "Transparency value for the image (values from 0 to 1)",
                            "digits": 1,
                            "minimum": 0.0,
                            "maximum": 1.0,
                            "suffix": ""
                        },
                        {
                            "type": "SelectColor",
                            "allowTransparent": true,
                            "name": "Kachelhintergrundfarbe",
                            "caption": "Tile background color"
                        }
                    ]
                }
            ]
        },
        {
            "type": "List",
            "name": "Residents",
            "caption": "Residents",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Status",
                    "name": "Variable",
                    "width": "auto",
                    "add": 0,
                    "save": true,
                    "edit": {
                        "type": "SelectVariable",
                        "validVariableTypes": [
                            0
                        ]
                    }
                },
                {
                    "caption": "Additional Info",
                    "name": "AdditionalInfo",
                    "width": "260px",
                    "add": 0,
                    "save": true,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Photo",
                    "name": "Image",
                    "width": "260px",
                    "add": 0,
                    "save": true,
                    "edit": {
                        "type": "SelectMedia"
                    }
                },
                {
                    "caption": "Distance",
                    "name": "Distance",
                    "width": "220px",
                    "add": 0,
                    "save": true,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Name override",
                    "name": "AltName",
                    "width": "200px",
                    "add": "",
                    "save": true,
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Options",
            "bold": true
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "Schriftgroesse",
                    "caption": "Status Font size in px",
                    "digits": 1,
                    "minimum": 1,
                    "maximum": 50,
                    "suffix": "px"
                },
                {
                    "type": "NumberSpinner",
                    "name": "InfoSchriftgroesse",
                    "caption": "Info Font size in px",
                    "digits": 1,
                    "minimum": 1,
                    "maximum": 50,
                    "suffix": "px"
                },
                {
                    "type": "NumberSpinner",
                    "name": "Eckenradius",
                    "caption": "Corner radius in %",
                    "digits": 1,
                    "minimum": 0.0,
                    "maximum": 50,
                    "suffix": "%"
                },
                {
                    "type": "NumberSpinner",
                    "name": "ImageMaxWidth",
                    "caption": "Maximum image width in %",
                    "minimum": 10,
                    "maximum": 100,
                    "step": 1,
                    "suffix": "%"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "NameSwitch",
                    "caption": "Display name"
                },
                {
                    "type": "CheckBox",
                    "name": "BedienungSwitch",
                    "caption": "Lock operation"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "GraustufenSwitch",
                    "caption": "Grayscale photos when absent"
                },
                {
                    "type": "HorizontalSlider",
                    "name": "Abwesenheitstransparenz",
                    "caption": "Photo opacity when absent",
                    "minimum": 0,
                    "maximum": 100,
                    "stepSize": 5,
                    "suffix": " %",
                    "displayValue": true
                }
            ]
        },
        {
            "type": "Label",
            "caption": ""
        },
        {
            "type": "Label",
            "caption": "Donations / Gifts"
        },
        {
            "type": "Label",
            "caption": "Say thank you and support the developer of this module:"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Image",
                    "onClick": "echo 'https://paypal.me/sspkbw25';",
                    "image": "data:image/jpeg;base64,"
                },
                {
                    "type": "Label",
                    "caption": ""
                },
                {
                    "type": "Image",
                    "onClick": "echo 'https://www.amazon.de/hz/wishlist/ls/2LE6P493HMWT0';",
                    "image": "data:image/jpeg;base64,"
                }
            ]
        }
    ]
}
